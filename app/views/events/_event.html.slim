= turbo_frame_tag event

  - li_attrs = {}
  - if defined?(map_view) && map_view
    - li_attrs["class"] = "border-l-8 border-white hover:cursor-pointer"
    - li_attrs["data-action"] = "click->map#onEventClick mouseenter->map#onEventMouseOver mouseleave->map#onEventMouseLeave"
    - li_attrs["data-map-target"] = "eventElt"
    - li_attrs["data-venue-id"] = event.venue.id

  li[*li_attrs]
    article.event-card class=(event.verified ? "bg-white" : "bg-yellow-faded-hard !text-blue-faded")

      div.md-hour = event.formatted_time

      div.event-card-main
        div.sm-hour
          p = event.formatted_time
          p = event.tarif

        div.name-desc-ctn
          div.flex.justify-between
            h3.name title=event.name = event.name
            - if policy(event).edit?
              div.flex.items-center.justify-between.gap-2

                - if event.unverified?
                  - if event.venue.verified?
                    /validation icon
                    = link_to verify_event_path(event), title: "✅ Valider l'événement", data: {turbo_method: :patch}
                      = inline_svg_tag "check_round.svg", class: "h-5 fill-blue-faded hover:fill-blue"
                - if event.venue.unverified?
                  /exclamation icon
                  = link_to unverified_path(section: "venues"), title: "❌ Le lieu n'est pas vérifié", data: {turbo_frame: :_top}
                    = inline_svg_tag "exclamation_round.svg", class: "h-5 fill-orange"
                /trash icon
                = link_to event_path(event), title: "❌ Supprimer l'événement", data: {turbo_method: :delete, turbo_confirm: "Supprimer cet événement ?"}
                  = inline_svg_tag "trash.svg", class: "h-4 fill-blue-faded hover:fill-blue"
                /edit icon
                = link_to edit_event_path(event), title: "Modifier l'événement"
                  = inline_svg_tag "edit.svg", class: "h-5 fill-blue-faded hover:fill-blue"

          p.description title=event.description = event.description

        address
          div.venue-name-address-ctn
            div.flex.flex-col.overflow-hidden
              p.venue-name title=event.venue.name = event.venue.name
              div.flex.gap-1.items-center
                p.venue-address title="#{event.venue.address}, #{event.venue.zipcode}"
                  = "#{event.venue.address}, #{event.venue.zipcode}"
          p.venue-city title=event.venue.city = event.venue.city

        div.md-tarif
          p = event.tarif

- @events.group_by(&:date).each do |date, events|

  section.event-day
    header.day-separator
      h3 = format_date(date)

      div.md-icons-container
        div class="flex-[0_1_49%] pl-2"
          = inline_svg_tag "list_marker.svg"
        div class="flex-[0_1_31%] pl-1"
          = inline_svg_tag "city.svg"
        div class="flex-[0_1_20%] flex justify-center"
          = inline_svg_tag "euro.svg"

    ul.events-list
      = render events

- if @pagy.next.present?

  - opts = {**@query_params, page: @pagy.next, format: :turbo_stream}
  - path = params[:action] == "unverified" ? unverified_events_path(opts) : events_path(opts)

  = turbo_stream.replace :next_page do
    = turbo_frame_tag :next_page, src: path, loading: :lazy

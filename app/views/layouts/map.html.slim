doctype html
html
  head
    = render "layouts/head"

  body.relative.overflow-hidden.max-w-screen.max-h-screen[
    data-controller="map"
    data-map-marker-icon-value=asset_path("map_marker.svg")
    data-map-location-icon-value=asset_path("map_location_marker.svg")
  ]

    = render "shared/flashes"

    div#map.absolute.top-0.bottom-0.left-0.right-0.z-0[
      class="@container/main"
    ]

    main.absolute.md:w-96.top-0.left-0.right-0.max-md:pb-18.h-dvh.flex.flex-col.pointer-events-none.touch-none[
      class="@container/main"
      data-map-target="mainElt"
    ]
      div.z-1000.pointer-events-auto.touch-none class="[&>nav]:p-4!"
        = render "shared/map_navbar"

      = turbo_frame_tag :searchform, target: :content

        search.w-full.mb-2 data-map-target="searchbar"

          = form_with(class: "w-full", method: :get, url: map_path) do |form|

            div.w-full.flex.items-center.flex-col.gap-4.py-4
              = render "shared/search_bar", form:
              = render "shared/location_filter", form:

            div.w-90.m-auto.relative.z-10.whitespace-nowrap.h-10.pointer-events-auto.touch-none[
              data-controller="datefilter"
              data-datefilter-initial-start-value="#{params[:start]}"
              data-action="click@window->datefilter#handleFocusOut"
            ]
              div.btn.p-0.overflow-hidden[
                class="@max-md:w-full bg-blue"
                data-datefilter-target="mainContainer"
              ]
                div.flex.px-2.py-1.gap-2.items-center.bg-blue.w-full data-action="click->datefilter#onButtonClick"
                  = inline_svg_tag "calendar.svg", class: "fill-light h-5"

                  div.flex.grow-1.justify-between.items-center.mx-2
                    = inline_svg_tag "left_arrow.svg",
                      class: "fill-light h-5 hover:fill-yellow",
                      data: {datefilter_target: "mapPrevDayBtn", action: "click->datefilter#onPreviousDayClick"}

                    span.text-lg.text-light.text-center.hover:cursor-pointer data-datefilter-target="button"
                      = params[:start]
                    = inline_svg_tag "right_arrow.svg",
                      class: "fill-light h-5 hover:fill-yellow",
                      data: {action: "click->datefilter#onNextDayClick"}
                /datepicker
                div.hidden.m-auto.size-max.min-w-fit.flex-col.p-2.cursor-default data-datefilter-target="datepickerContainer"

      = yield

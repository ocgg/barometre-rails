template data-controller="beta-warning"
  div.flex.flex-wrap.justify-center.items-center.gap-2
    /danger icon
    = inline_svg_tag "warning.svg", class: "h-6 fill-blue"

    h3.text-lg.text-blue.text-center
      | Ce site est en plein développement&nbsp;!

  ul.list-disc.pl-6
    li.font-paragraph.mb-2
      | Le site n'a pas encore de nom de domaine, même le nom n'est pas définitif !
      br
      | Il est en ligne en tant que "bêta-test", dans le but de faire tester, corriger les bugs et récolter des avis.

    li.font-paragraph.mb-2
      |> Pour en savoir plus sur les étapes de développement,
      = link_to "visitez cette page", about_path, class: "underline decoration-dotted"
      | .

    li.font-paragraph
      | Vous nous serez d'une grande aide en nous faisant remonter les problèmes et bugs que vous rencontrez, ou simplement en nous faisant part de vos remarques ou suggestions.
      br
      |> Pour ce faire, passez par le
      = link_to "formulaire de contact", contact_path, class: "underline decoration-dotted"
      | .

  p.text-center Merci pour votre aide !

  p.text-blue-faded.text-sm.italic.font-paragraph.text-center
    | Cliquez n'importe où pour fermer

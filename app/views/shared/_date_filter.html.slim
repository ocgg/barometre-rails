div.relative.z-30.whitespace-nowrap.bg-light.h-9[
  data-controller="datefilter"
  data-datefilter-range-value="true"
  data-action="click@window->datefilter#handleFocusOut"
]
  div.btn.px-2.w-fit class="@max-3xl:w-90" data-datefilter-target="mainContainer"
    div.flex.gap-2.items-center data-action="click->datefilter#onButtonClick"
      = inline_svg_tag "calendar.svg", class: "h-5 fill-blue"

      span.grow-1.text-lg.text-center.hover:cursor-pointer data-datefilter-target="button"
        | Filtrer par dates

      = inline_svg_tag "cross_round.svg",
        class: "hidden h-5 fill-blue-faded hover:fill-yellow",
        data: {action: "click->datefilter#clearInput", datefilter_target: "clearInputBtn"}

    /datepicker
    div.hidden.size-max.flex-col.p-2.m-auto.cursor-default data-datefilter-target="datepickerContainer"

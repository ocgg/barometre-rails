- if flash[:notice]
  template data-controller="flashes"
    p.text-blue
      = flash[:notice]

    = inline_svg_tag "check_round_light.svg", class: "h-12 fill-blue group-has-hover:fill-yellow"

    div
      p.text-blue.font-paragraph
        = flash[:subtext]
      p.text-blue-faded.text-sm.italic.font-paragraph.text-center
        | Cliquez n'importe où pour fermer

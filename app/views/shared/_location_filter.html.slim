div.relative.z-20.whitespace-nowrap.h-9.pointer-events-auto.touch-none[
  data-controller="locationfilter"
  data-action="click@window->locationfilter#handleFocusOut"
]
  div.btn.px-2.w-fit.bg-light class="@max-3xl:w-90" data-locationfilter-target="mainContainer"
    = form.submit "", class: "hidden", data: {locationfilter_target: "submit"}
    div.flex.gap-2.items-center data-action="click->locationfilter#onButtonClick"
      = form.hidden_field :lat,
        disabled: !params[:radius],
        data: {locationfilter_target: "latInput"},
        value: params[:lat]
      = form.hidden_field :long,
        disabled: !params[:radius],
        data: {locationfilter_target: "longInput"},
        value: params[:long]

      = inline_svg_tag "location_marker.svg", class: "fill-blue h-5"
      span.text-lg.grow-1.text-center.hover:cursor-pointer data-locationfilter-target="button"

      div.hidden data-locationfilter-target="spinner" role="status"
        = inline_svg_tag "spinner.svg",
          class: "w-4 h-4 text-blue-faded animate-spin fill-blue",
          aria_hidden: true,
          fill: "none"
      /clear input icon
      = inline_svg_tag "cross_round.svg",
        class: "hidden h-5 fill-blue-faded hover:fill-yellow",
          data: {locationfilter_target: "clearInputBtn", action: "click->locationfilter#clearInput"}
    div[
      class="hidden flex flex-col gap-1 size-max min-w-fit p-2 m-auto cursor-auto"
      data-locationfilter-target="rangeContainer"
    ]
      = form.range_field :radius,
        value: params[:radius],
        disabled: !params[:radius],
        data: { locationfilter_target: "radiusInput",
          action: "input->locationfilter#onRadiusInput pointerup->locationfilter#onPointerUp" },
        in: 2..30, step: 2
      a.text-center.text-blue-faded.text-sm.hover:text-yellow data-action="click->locationfilter#requestLocation"
        | Mettre à jour ma position

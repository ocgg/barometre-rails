nav.flex.justify-between[
  data-controller="navbar"
  data-action="click@window->navbar#handleFocusOut"
  class="fixed z-1000 bottom-0 gap-4 w-screen px-[7vw] bg-blue md:w-full md:pr-0 md:pl-24 py-4 md:static"
]
  ul.flex.grow.items-center.md:gap-12 class="gap-[7vw]"
    - if current_user.admin?
      li
        = link_to unverified_path, class: "block", title: "(admin) Concerts & lieux à vérifier"
          = inline_svg_tag "list_lock.svg", class: "h-10 #{navbar_btn_color('unverified')}"
    li
      = link_to new_event_path, class: "block", title: "Proposer un concert"
        = inline_svg_tag "calendar_plus.svg", class: "h-10 #{navbar_btn_color('new')}"
    li
      = link_to root_path, class: "block", title: "Vue liste"
        = inline_svg_tag "calendar.svg", class: "h-8 #{navbar_btn_color('index')}"
    li
      = link_to map_path, class: "block", title: "Vue carte"
        = inline_svg_tag "map_with_marker.svg", class: "h-8 #{navbar_btn_color('map')}"

  div.relative.md:pr-4 data-navbar-target="main"
    div title="Menu"
      = inline_svg_tag "burger_menu.svg",
        class: "h-10 #{navbar_btn_color('menu')} cursor-pointer fill-(--light-bg)",
        tabindex: 0,
        data: {action: "click->navbar#toggle keydown.enter->navbar#toggle",
               navbar_target: "icon"}

    ul.z-1000[
      data-navbar-target="dropdown"
      class="hidden fixed bottom-18 right-0 w-full flex-col-reverse gap-2 items-center p-2 bg-white text-xl md:flex-col md:items-end md:absolute md:min-w-3xs md:rounded-b-xl md:top-14 md:bottom-auto"
    ]
      li.hover:text-yellow = link_to "Proposer un concert", new_event_path
      li.hover:text-yellow = link_to "Contact", contact_path
      li.hover:text-yellow = link_to "À propos", about_path
      - if current_user.admin?
        li.hover:text-yellow
          = button_to "Déconnexion admin", session_path, method: :delete, data: {turbo: false}

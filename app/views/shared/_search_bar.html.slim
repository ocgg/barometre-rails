div.group.flex.gap-1.border-3.rounded-lg.border-blue.bg-light.pointer-events-auto.touch-none[
  class="@max-3xl:w-90 @3xl:basis-70 focus-within:bg-white [&:has(input[type=search]:not(:placeholder-shown))]:bg-white focus-within:border-yellow hover:border-yellow"
  data-controller="search"
]
  = form.submit "", class: "hidden", data: {search_target: "submit"}
  = form.search_field :q,
    class: "peer grow w-12 pl-3 pr-0 border-none font-base",
    placeholder: "Rechercher...",
    value: params[:q],
    data: {search_target: "input", action: "keydown.enter->search#submit"}

  /clear input btn
  = inline_svg_tag "cross_round.svg",
    class: "cursor-pointer hover:fill-yellow hidden peer-not-placeholder-shown:block h-5 fill-blue-faded self-center",
    data: {action: "click->search#clearInput"}

  /magnifying glass btn
  button[
    data-action="click->search#submit"
    class="pl-3 pr-2.5 border-none rounded-none bg-blue"
    class="group-hover:bg-yellow group-focus-within:bg-yellow"
  ]
    = inline_svg_tag "search.svg", class: "h-5 fill-light"

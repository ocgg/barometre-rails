div[
  data-controller="venue-fields"
  data-venue-fields-mode-value=venue_fields_mode(venue)
]
  = fields_for for_params, venue do |venue_fields|

    div.relative.flex.flex-col.gap-2 data-events-form-target="venueFields"

      - if defined? event_fields
        = event_fields.hidden_field :venue_id,
          data: {venue_fields_target: "id"}

      div
        = venue_fields.text_field :name,
          class: "venue-name font-normal w-full #{"border-orange" if event.errors[:venue].present?}",
          placeholder: "Chercher un lieu...",
          data: { action: "focus->venue-fields#onFocus keyup->venue-fields#onVenueInput",
                  venue_fields_target: "name"}

        div.hidden.absolute.top-2.right-1[
          data-venue-fields-target="clearInputBtn"
          data-action="click->venue-fields#onClearBtnClick"
          viewBox="0 0 512 512"
          title="Réinitialiser la recherche"
        ]
          = inline_svg_tag "cross_round.svg", class: "h-5 fill-blue-faded hover:fill-yellow hover:cursor-pointer"

        /search icon
        div.hidden.absolute.top-2.right-1[
            data-venue-fields-target="searchBtn"
            data-action="click->venue-fields#onSearchBtnClick"
            title="Chercher dans la liste"
        ]
          = inline_svg_tag "search.svg", class: "h-5 fill-blue-faded hover:fill-yellow hover:cursor-pointer"

        div.hidden.z-40.absolute.top-10.rounded-md.bg-white.border-2.border-yellow[
          data-events-form-target="venueDropdown"
          data-venue-fields-target="dropdown"
        ]
          ul data-venue-fields-target="resultsList"

          template data-venue-fields-target="template"
            li.p-2.font-paragraph.hover:bg-yellow.hover:cursor-pointer[
              data-action="click->venue-fields#onVenueSelect"
            ]
              div.flex.gap-2.items-center
                - if policy(venue).edit?
                  = link_to unverified_path(section: "venues"), title: "❌ Le lieu n'est pas vérifié", data: {turbo_frame: :_top}
                    = inline_svg_tag "exclamation_round.svg", class: "h-4 fill-orange"

                p.venue-name-selector.font-bold.text-lg/5.text-ellipsis.overflow-hidden.whitespace-nowrap
              p.venue-address-selector.text-sm.text-blue-faded.text-ellipsis.overflow-hidden.whitespace-nowrap

          div.p-2.italic.text-center.text-blue-faded.font-paragraph data-venue-fields-target="noResult"
            | Aucun résultat

          hr.border-yellow-faded

          div.p-2.text-center.font-paragraph.hover:bg-yellow.hover:cursor-pointer[
            data-action="click->venue-fields#onAddManually"
          ]
            p.font-bold Ajouter manuellement

      div.flex.flex-col.gap-2.relative
        = venue_fields.text_field :address,
          placeholder: "Adresse",
          data: {venue_fields_target: "address",
            action: "keyup->venue-fields#onAddressInput"}

        div.hidden.z-40.absolute.top-10.rounded-md.bg-white.border-2.border-yellow[
          data-events-form-target="venueDropdown"
          data-venue-fields-target="addressDropdown"
        ]
          ul data-venue-fields-target="addressesList"

          template data-venue-fields-target="addressTemplate"
            li.px-2.py-1.min-w-55.leading-5.font-paragraph.hover:bg-yellow.hover:cursor-pointer.focus:bg-yellow[
              data-action="click->venue-fields#onAddressSelect"
              tabindex=0
            ]
              p.address-first.text-ellipsis.overflow-hidden.whitespace-nowrap
              p.address-last.text-blue-faded.text-ellipsis.overflow-hidden.whitespace-nowrap

        div.flex.gap-2
          = venue_fields.text_field :zipcode,
            maxlength: 5,
            placeholder: "CP",
            data: {venue_fields_target: "zipcode"}

          = venue_fields.text_field :city,
            class: "w-full",
            placeholder: "Ville",
            data: {venue_fields_target: "city"}
